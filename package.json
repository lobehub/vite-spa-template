{
  "name": "@lobehub/vite-spa-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React SPA with Vite, React Router, LobeHub UI, tRPC, and a Tsuki/Hono server.",
  "license": "MIT",
  "repository": "https://github.com/lobehub/vite-spa-template",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"pnpm --filter @lobehub/template-web dev\" \"pnpm --filter @lobehub/template-server dev\"",
    "build": "pnpm -r build",
    "build:vercel": "pnpm build && node scripts/buildVercelOutput.mjs",
    "start": "pnpm --filter @lobehub/template-server start",
    "type-check": "pnpm -r type-check",
    "test": "pnpm --filter @lobehub/template-server test",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.7.4"
  }
}
