{
  "name": "@lobehub/vite-spa-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React SPA with Vite, React Router, LobeHub UI, tRPC, and a Tsuki/Hono server.",
  "license": "MIT",
  "repository": "https://github.com/lobehub/vite-spa-template",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite\" \"vite-node --config vite.server.config.ts --watch src/server/main.ts\"",
    "build": "vite build && vite build --config vite.server.config.ts",
    "build:vercel": "pnpm build && node scripts/buildVercelOutput.mjs",
    "start": "node dist-server/main.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@lobehub/ui": "^5.58.0",
    "@tanstack/react-query": "^5.104.2",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@tsuki-hono/common": "0.0.5",
    "@tsuki-hono/core": "0.0.5",
    "antd": "^6.1.3",
    "antd-style": "^4.1.0",
    "hono": "^4.13.1",
    "motion": "^12.23.26",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@swc/core": "^1.16.18",
    "@types/node": "^22.19.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.7.4",
    "typescript": "^7.0.2",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4"
  }
}
